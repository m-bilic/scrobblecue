# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored – never commit real keys.
# The backend reads it automatically when started locally.

# Last.fm – https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Discogs – https://www.discogs.com/settings/developers (Create an application)
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_USER_AGENT=ScrobbleCue/0.1 +https://github.com/<your-username>/scrobblecue

# Sealing keys for credential bundles, newest first: id:base64key,id:base64key
# Generate a key with:  openssl rand -base64 32
CREDENTIAL_KEYS=

# Where the backend and website run
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
# Production: https://scrobblecue.app/android/auth (verified App Link).
# Locally: the development app's own link (debug builds). For curl tests without the app,
# http://localhost:8080/dev/auth-done.html shows the bundle instead.
ANDROID_AUTH_LINK=scrobblecue-dev://auth

# Oldest client versions still allowed (GET /v1/meta)
MIN_CLIENT_VERSION_ANDROID=0.0.0
MIN_CLIENT_VERSION_WEB=0.0.0
